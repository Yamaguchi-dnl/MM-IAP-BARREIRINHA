# URL do projeto Supabase (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=

# Chave anônima (public) do projeto Supabase (Project Settings > API)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Chave de service role do Supabase (Project Settings > API)
# NUNCA exponha esta chave no navegador. É usada apenas em Server Actions.
SUPABASE_SERVICE_ROLE_KEY=

# URL pública do site (usada em metadados, SEO e links absolutos)
# Em desenvolvimento: http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
